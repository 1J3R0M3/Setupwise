<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders every page of the real app and saves screenshots to artifacts/screenshots.
       Runs on Windows only (CI job "UI screenshots"). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Setupwise.App\Setupwise.App.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Test method names describe behaviour with underscores -->
    <NoWarn>$(NoWarn);CA1707;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Setupwise.Core\Setupwise.Core.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real catalog is tested so that broken pull requests fail CI -->
    <None Include="..\..\catalog\catalog.json" Link="catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

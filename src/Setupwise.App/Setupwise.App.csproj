<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Setupwise</AssemblyName>
    <RootNamespace>Setupwise.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\setupwise.ico</ApplicationIcon>
    <Description>Set up a new Windows PC in minutes.</Description>
    <!-- Only ship framework resources for the languages Setupwise supports -->
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
    <!-- CA1515: WPF needs public types for XAML; CA2007: UI code must resume on the UI thread;
         CA1822: properties used by data binding must be instance members -->
    <NoWarn>$(NoWarn);CA1515;CA2007;CA1822</NoWarn>
    <!-- Distribution flavour: "Standard" (installer/zip from GitHub) or "Store" (MSIX, see installer/msix) -->
    <SetupwiseFlavor Condition="'$(SetupwiseFlavor)' == ''">Standard</SetupwiseFlavor>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SetupwiseFlavor" Value="$(SetupwiseFlavor)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Setupwise.Core\Setupwise.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\catalog\catalog.json" Link="catalog.json" LogicalName="Setupwise.catalog.json" />
    <EmbeddedResource Include="Localization\Strings\*.json" LogicalName="Setupwise.Strings.%(Filename).json" />
    <Resource Include="..\..\assets\setupwise-256.png" Link="Assets\setupwise-256.png" />
  </ItemGroup>

  <!-- Windows tweaks (R-19) only in the installer/zip build: the Store package does not contain them -->
  <ItemGroup Condition="'$(SetupwiseFlavor)' != 'Store'">
    <EmbeddedResource Include="..\..\catalog\tweaks.json" Link="tweaks.json" LogicalName="Setupwise.tweaks.json" />
  </ItemGroup>

</Project>

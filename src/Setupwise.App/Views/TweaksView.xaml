<UserControl x:Class="Setupwise.App.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Setupwise.App.ViewModels"
             xmlns:loc="clr-namespace:Setupwise.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TweaksViewModel}">
  <Grid Margin="32,24,32,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
    </StackPanel>

    <!-- What tweaks do, and the safety net -->
    <Border Grid.Row="1" Margin="0,0,0,12" Padding="16,12" CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <DockPanel>
        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning24" Filled="True" FontSize="20" Margin="0,0,14,0" VerticalAlignment="Top"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
        <StackPanel>
          <TextBlock Text="{loc:Tr Tweaks_Intro}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <CheckBox Margin="0,8,0,0" Content="{loc:Tr Tweaks_RestorePoint}" IsChecked="{Binding CreateRestorePoint}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <DockPanel Grid.Row="2" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ui:Button Content="{loc:Tr Tweaks_Refresh}" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshStatesCommand}" />
        <ui:Button Margin="8,0,0,0" Content="{loc:Tr Tweaks_Undo}" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding UndoCommand}" />
        <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="{loc:Tr Tweaks_Apply}" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ApplyCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding SelectionText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Margin="0,0,-16,0" Padding="0,0,16,0" Focusable="False">
      <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:TweakGroupViewModel}">
            <StackPanel Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Margin="8,0,0,0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
                    <CheckBox Style="{StaticResource PackageCard}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,0,4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Margin="16,0,0,0" Symbol="ShieldKeyhole20" FontSize="16" VerticalAlignment="Center"
                                       ToolTip="{loc:Tr Tweaks_NeedsAdmin}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding NeedsAdministrator, Converter={StaticResource BoolToVisibility}}" />
                        <Border x:Name="StatePill" Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource Pill}" VerticalAlignment="Center">
                          <TextBlock x:Name="StateText" Text="{Binding StateText}" FontSize="12"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                      </Grid>
                    </CheckBox>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsOn}" Value="True">
                        <Setter TargetName="StatePill" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                        <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>

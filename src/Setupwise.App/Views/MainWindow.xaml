<ui:FluentWindow x:Class="Setupwise.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Setupwise.App.ViewModels"
                 xmlns:views="clr-namespace:Setupwise.App.Views"
                 xmlns:loc="clr-namespace:Setupwise.App.Localization"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="Setupwise" Width="1180" Height="780" MinWidth="900" MinHeight="580"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

  <ui:FluentWindow.Resources>
    <!-- Pages are view models; these templates pick the matching view -->
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PackageListPageViewModel}">
      <views:PackageListView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Setupwise">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Setupwise;component/Assets/setupwise-256.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="264" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Navigation -->
      <DockPanel Grid.Column="0" Margin="8,0,8,12">
        <TextBlock DockPanel.Dock="Top" Margin="16,0,0,12" Text="{loc:Tr App_Tagline}" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                 ItemContainerStyle="{StaticResource NavItemStyle}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
      </DockPanel>

      <!-- Content layer -->
      <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
              Background="{DynamicResource LayerFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <DockPanel>

          <!-- Action bar -->
          <Border DockPanel.Dock="Bottom" Padding="32,14" BorderThickness="0,1,0,0"
                  BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                  <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True"
                                   Visibility="{Binding IsBusyIndicatorVisible, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <ProgressBar Margin="0,8,0,0" Height="4" MinHeight="4" Maximum="1" Value="{Binding OverallProgress}"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="{loc:Tr Bar_Console}" Icon="{ui:SymbolIcon WindowConsole20}" Command="{Binding ToggleConsoleCommand}"
                           ToolTip="{loc:Tr Console_Tooltip}" />
                <ui:Button Margin="8,0,0,0" Content="{loc:Tr Bar_Log}" Icon="{ui:SymbolIcon DocumentBulletList24}" Command="{Binding ToggleLogCommand}" />
                <ui:Button Margin="8,0,0,0" Content="{loc:Tr Bar_Cancel}" Icon="{ui:SymbolIcon Stop24}" Command="{Binding CancelCommand}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Margin="8,0,0,0" Appearance="Primary" MinWidth="140" Content="{loc:Tr Bar_Install}"
                           Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding InstallCommand}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Log -->
          <Border DockPanel.Dock="Bottom" Height="240" Margin="32,0,32,12" Style="{StaticResource Card}" Padding="0"
                  Visibility="{Binding IsLogOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
              <!-- Console: own winget commands -->
              <DockPanel DockPanel.Dock="Bottom" Margin="8,0,8,8"
                         Visibility="{Binding IsConsoleOpen, Converter={StaticResource BoolToVisibility}}">
                <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{loc:Tr Console_Stop}" Icon="{ui:SymbolIcon Stop24}"
                           Command="{Binding StopConsoleCommand}"
                           Visibility="{Binding IsConsoleRunning, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Appearance="Primary" Content="{loc:Tr Console_Run}"
                           Icon="{ui:SymbolIcon Play24}" Command="{Binding RunConsoleCommand}" />
                <TextBlock DockPanel.Dock="Left" Margin="8,0,8,0" VerticalAlignment="Center" Text="winget"
                           FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox x:Name="ConsoleBox" PlaceholderText="{loc:Tr Console_Placeholder}" FontFamily="Cascadia Mono, Consolas"
                            Text="{Binding ConsoleInput, UpdateSourceTrigger=PropertyChanged}">
                  <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding RunConsoleCommand}" />
                  </ui:TextBox.InputBindings>
                </ui:TextBox>
              </DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="16,8,8,4">
                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Content="{loc:Tr Log_Clear}" Command="{Binding ClearLogCommand}" />
                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Content="{loc:Tr Log_OpenFolder}" Command="{Binding OpenLogFolderCommand}" />
                <TextBlock Text="{loc:Tr Log_Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              </DockPanel>
              <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0"
                       Margin="8,0,8,8" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="8,1"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
              </ListBox>
            </DockPanel>
          </Border>

          <!-- Info bar -->
          <Border x:Name="InfoBar" DockPanel.Dock="Top" Margin="32,20,32,0" Padding="16,10,8,10" CornerRadius="6" BorderThickness="1"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  Visibility="{Binding Info, Converter={StaticResource NullToCollapsed}}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Info.Kind}" Value="{x:Static vm:InfoKind.Success}">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Info.Kind}" Value="{x:Static vm:InfoKind.Warning}">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Info.Kind}" Value="{x:Static vm:InfoKind.Error}">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <DockPanel>
              <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,0,14,0" FontSize="20" Symbol="{Binding Info.Symbol}" Filled="True">
                <ui:SymbolIcon.Style>
                  <Style TargetType="ui:SymbolIcon">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Info.Kind}" Value="{x:Static vm:InfoKind.Success}">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Info.Kind}" Value="{x:Static vm:InfoKind.Warning}">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Info.Kind}" Value="{x:Static vm:InfoKind.Error}">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:SymbolIcon.Style>
              </ui:SymbolIcon>
              <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="8" Icon="{ui:SymbolIcon Dismiss16}"
                         Command="{Binding CloseInfoCommand}" VerticalAlignment="Center" />
              <ui:Button DockPanel.Dock="Right" Margin="12,0,4,0" Content="{Binding Info.ActionText}" Command="{Binding RunInfoActionCommand}"
                         VerticalAlignment="Center" Visibility="{Binding Info.HasAction, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <Run Text="{Binding Info.Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Info.Text, Mode=OneWay}" />
              </TextBlock>
            </DockPanel>
          </Border>

          <!-- Current page -->
          <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</ui:FluentWindow>

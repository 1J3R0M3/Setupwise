<UserControl x:Class="Setupwise.App.Views.PackageListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Setupwise.App.ViewModels"
             xmlns:loc="clr-namespace:Setupwise.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SearchViewModel}">
  <!-- Shared view for categories, search, updates and the selection -->
  <Grid Margin="32,24,32,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,12" MinHeight="34">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Buttons that only exist on some pages: one template per page type -->
        <ContentControl Content="{Binding}" Focusable="False" IsTabStop="False">
          <ContentControl.Resources>
            <DataTemplate DataType="{x:Type vm:PackageListPageViewModel}" />
            <DataTemplate DataType="{x:Type vm:CategoryViewModel}" />

            <DataTemplate DataType="{x:Type vm:SearchViewModel}">
              <StackPanel Orientation="Horizontal">
                <ui:TextBox Width="360" PlaceholderText="{loc:Tr Search_Placeholder}" Loaded="OnSearchBoxLoaded"
                            Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                            Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}">
                  <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                  </ui:TextBox.InputBindings>
                </ui:TextBox>
                <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="{loc:Tr Search_Button}" Command="{Binding SearchCommand}" />
              </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
              <ui:Button Content="{loc:Tr Updates_Refresh}" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:InstalledViewModel}">
              <ui:Button Content="{loc:Tr Updates_Refresh}" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SelectionViewModel}">
              <StackPanel Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Content="{loc:Tr Selection_SaveAsCategory}" Icon="{ui:SymbolIcon FolderAdd24}"
                           Command="{Binding SaveAsCategoryCommand}"
                           Visibility="{Binding ShowSaveAsCategory, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="{loc:Tr Selection_Clear}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding ClearCommand}" />
              </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CustomCategoryViewModel}">
              <StackPanel Orientation="Horizontal">
                <ui:Button Content="{loc:Tr Custom_Rename}" Icon="{ui:SymbolIcon Rename24}" Command="{Binding RenameCommand}" />
                <ui:Button Margin="8,0,0,0" Content="{loc:Tr Custom_Delete}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteCommand}" />
              </StackPanel>
            </DataTemplate>
          </ContentControl.Resources>
        </ContentControl>
        <!-- Busy -->
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
          <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
          <TextBlock Margin="8,0,0,0" Text="{Binding BusyText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                  Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <CheckBox Margin="20,0,0,0" Content="{loc:Tr List_SelectAll}" IsThreeState="False"
                  IsChecked="{Binding AllSelected, Mode=TwoWay}" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Margin="0,0,-16,0" Padding="0,0,16,0" Focusable="False">
      <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PackageCardTemplate}" Focusable="False" />
    </ScrollViewer>

    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
      <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="44" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      <TextBlock Margin="0,14,0,0" MaxWidth="400" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding EmptyText}"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>
  </Grid>
</UserControl>

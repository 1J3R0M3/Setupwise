<UserControl x:Class="Setupwise.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Setupwise.App.ViewModels"
             xmlns:loc="clr-namespace:Setupwise.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
  <UserControl.Resources>
    <Style x:Key="SettingRow" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Padding" Value="16,12" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,24,32,24" MaxWidth="1000" HorizontalAlignment="Stretch">
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

      <!-- Appearance -->
      <TextBlock Text="{loc:Tr Settings_Appearance}" Style="{StaticResource SectionHeader}" />
      <ui:CardControl Style="{StaticResource SettingRow}" Icon="{ui:SymbolIcon DarkTheme24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="{loc:Tr Settings_Theme}" />
            <TextBlock Text="{loc:Tr Settings_ThemeDesc}" Style="{StaticResource Caption}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ComboBox Width="220" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Label" />
      </ui:CardControl>
      <ui:CardControl Style="{StaticResource SettingRow}" Icon="{ui:SymbolIcon LocalLanguage24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="{loc:Tr Settings_Language}" />
            <TextBlock Text="{loc:Tr Settings_LanguageDesc}" Style="{StaticResource Caption}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ComboBox Width="220" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Label" />
      </ui:CardControl>
      <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,4"
              Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
              Visibility="{Binding LanguageChanged, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="{loc:Tr Settings_RestartNow}" Command="{Binding RestartNowCommand}" />
          <TextBlock Text="{loc:Tr Settings_LanguageRestart}" VerticalAlignment="Center" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </DockPanel>
      </Border>

      <!-- Privacy -->
      <TextBlock Text="{loc:Tr Settings_Privacy}" Style="{StaticResource SectionHeader}" />
      <ui:CardControl Style="{StaticResource SettingRow}" Icon="{ui:SymbolIcon Image24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="{loc:Tr Settings_Icons}" />
            <TextBlock Text="{loc:Tr Settings_IconsDesc}" Style="{StaticResource Caption}" />
          </StackPanel>
        </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal">
          <ui:Button Appearance="Transparent" Margin="0,0,12,0" Content="{loc:Tr Settings_ClearIcons}" Command="{Binding ClearIconCacheCommand}" />
          <ui:ToggleSwitch IsChecked="{Binding LoadIcons}" />
        </StackPanel>
      </ui:CardControl>
      <ui:CardControl Style="{StaticResource SettingRow}" Icon="{ui:SymbolIcon ArrowSync24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="{loc:Tr Settings_AppUpdates}" />
            <TextBlock Text="{loc:Tr Settings_AppUpdatesDesc}" Style="{StaticResource Caption}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding CheckForAppUpdates}" />
      </ui:CardControl>

      <!-- Advanced -->
      <TextBlock Text="{loc:Tr Settings_Advanced}" Style="{StaticResource SectionHeader}" />
      <ui:CardControl Style="{StaticResource SettingRow}" Icon="{ui:SymbolIcon Shield24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="{loc:Tr Settings_Admin}" />
            <TextBlock Text="{Binding AdminText, Mode=OneTime}" Style="{StaticResource Caption}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:Button Content="{loc:Tr Settings_RestartAdmin}" Command="{Binding RestartAsAdministratorCommand}"
                   Visibility="{Binding IsAdministrator, Converter={StaticResource InverseBoolToVisibility}}" />
      </ui:CardControl>
      <ui:CardControl Style="{StaticResource SettingRow}" Icon="{ui:SymbolIcon DocumentBulletList24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="{loc:Tr Settings_Logs}" />
            <TextBlock Text="{loc:Tr Settings_LogsDesc}" Style="{StaticResource Caption}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:Button Content="{loc:Tr Log_OpenFolder}" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenLogsCommand}" />
      </ui:CardControl>

      <!-- About -->
      <TextBlock Text="{loc:Tr Settings_About}" Style="{StaticResource SectionHeader}" />
      <Border Style="{StaticResource Card}" Padding="16">
        <DockPanel>
          <Image DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top"
                 Source="pack://application:,,,/Assets/setupwise-256.png" RenderOptions.BitmapScalingMode="HighQuality" />
          <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="{loc:Tr Settings_GitHub}"
                     Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenGitHubCommand}" />
          <StackPanel>
            <TextBlock Text="Setupwise" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding WingetText}" Style="{StaticResource Caption}" />
            <TextBlock Text="{loc:Tr Settings_License}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl x:Class="Setupwise.App.Views.Controls.PackageTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Setupwise.App.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance models:PackageItem}"
             x:Name="Root">
  <!-- App icon, or a colored tile with the first letter while no icon is available.
       Drawn at 32x32 and scaled by the Viewbox to the requested size. -->
  <Viewbox Width="{Binding Size, ElementName=Root}" Height="{Binding Size, ElementName=Root}" Stretch="Uniform">
    <Grid Width="32" Height="32">
      <Border CornerRadius="6" Background="{Binding TileBrush}"
              Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}">
        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <!-- DownOnly: tiny favicons stay sharp instead of being blown up -->
      <Image Source="{Binding Icon}" Stretch="Uniform" StretchDirection="DownOnly"
             RenderOptions.BitmapScalingMode="HighQuality">
        <Image.Clip>
          <RectangleGeometry Rect="0,0,32,32" RadiusX="6" RadiusY="6" />
        </Image.Clip>
      </Image>
    </Grid>
  </Viewbox>
</UserControl>

<ui:FluentWindow x:Class="Setupwise.App.Views.TextPromptWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:Setupwise.App.Localization"
                 Width="440" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
  <StackPanel>
    <ui:TitleBar x:Name="TitleBar" ShowMaximize="False" ShowMinimize="False" />
    <StackPanel Margin="24,4,24,24">
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <ui:TextBox x:Name="Input" MaxLength="60" ClearButtonEnabled="True" TextChanged="OnTextChanged" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <ui:Button x:Name="OkButton" Appearance="Primary" MinWidth="110" IsDefault="True"
                   Content="{loc:Tr Dialog_Ok}" Click="OnOk" IsEnabled="False" />
        <ui:Button Margin="8,0,0,0" MinWidth="110" IsCancel="True" Content="{loc:Tr Dialog_Cancel}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</ui:FluentWindow>

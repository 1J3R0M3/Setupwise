<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer" (slug: installer).
     Signs the Inno Setup installer built from the already signed app files.
     Keep in sync with the SignPath project settings (copy the content there). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set product-name="Setupwise">
      <include path="Setupwise-*-Setup-x64.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
